[
 {
  "type": "chart",
  "icon": "chart-line",
  "category": "data",
  "pin": true,
  "hint": "Numbers over time or across categories (line or bar), with a chart / table switch and CSV / PNG export.",
  "fields": "{kind?: \"line\"|\"bar\", series: [{name, points: [[x, y]]}] (1-6 series), unit?, title?, source?}",
  "schema": {
   "type": "object",
   "required": [
    "series"
   ],
   "properties": {
    "title": {
     "type": "string",
     "maxLength": 200
    },
    "source": {
     "type": "string",
     "maxLength": 300
    },
    "kind": {
     "enum": [
      "line",
      "bar"
     ]
    },
    "unit": {
     "type": "string",
     "maxLength": 20
    },
    "series": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "type": "object",
      "required": [
       "name",
       "points"
      ],
      "properties": {
       "name": {
        "type": "string",
        "maxLength": 80
       },
       "points": {
        "type": "array",
        "maxItems": 1000,
        "items": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2,
         "items": [
          {
           "type": [
            "number",
            "string"
           ]
          },
          {
           "type": "number"
          }
         ]
        }
       }
      }
     }
    }
   }
  }
 },
 {
  "type": "table",
  "icon": "table",
  "category": "data",
  "pin": true,
  "hint": "Tabular data the user can sort, filter and export as CSV.",
  "fields": "{columns: [label | {label, type?: \"text\"|\"number\"|\"percent\"|\"delta\"|\"bar\", unit?, align?}], rows: [[cell]], title?, source?, page_size?}",
  "schema": {
   "type": "object",
   "required": [
    "columns",
    "rows"
   ],
   "properties": {
    "title": {
     "type": "string",
     "maxLength": 200
    },
    "source": {
     "type": "string",
     "maxLength": 300
    },
    "page_size": {
     "type": "integer",
     "minimum": 1,
     "maximum": 500
    },
    "columns": {
     "type": "array",
     "minItems": 1,
     "maxItems": 40,
     "items": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 120
       },
       {
        "type": "object",
        "required": [
         "label"
        ],
        "properties": {
         "label": {
          "type": "string",
          "maxLength": 120
         },
         "align": {
          "enum": [
           "left",
           "right",
           "center"
          ]
         },
         "unit": {
          "type": "string",
          "maxLength": 20
         },
         "type": {
          "enum": [
           "text",
           "number",
           "percent",
           "delta",
           "bar"
          ]
         }
        }
       }
      ]
     }
    },
    "rows": {
     "type": "array",
     "maxItems": 5000,
     "items": {
      "type": "array",
      "maxItems": 40,
      "items": {
       "type": [
        "string",
        "number",
        "boolean",
        "null"
       ]
      }
     }
    }
   }
  }
 },
 {
